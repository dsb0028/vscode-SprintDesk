{
  "name": "vscode-sprintdesk",
  "publisher": "khmamed",
  "displayName": "vscode-SprintDesk",
  "description": "A Visual Studio Code extension for managing sprints and tasks in an agile development workflow",
  "version": "0.4.0",
  "repository": {
    "url": "https://github.com/khmmamed/vscode-SprintDesk.git",
    "type": "git"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:sprintdesk.viewProjects"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development --config ./webpack/extension.config.js",
    "watch": "npm-run-all --parallel watch:*",
    "watch:ext": "webpack --mode development --watch --config ./webpack/extension.config.js",
    "watch:wv": "webpack serve --mode development --config ./webpack/webview.config.js",
    "package": "npm run clean && npm-run-all --parallel package:*",
    "package:ext": "webpack --mode production --config ./webpack/extension.config.js",
    "package:wv": "webpack --mode production --config ./webpack/webview.config.js",
    "compile-tests": "tsc -p . --outDir out --noEmit false",
    "test:calendar": "npm run compile-tests && node out/calendar/sprintCalendar.test.js",
    "test:data-service": "npm run compile-tests && node out/data/DataService.test.js",
    "test:task-statuses": "npm run compile-tests && node out/providers/taskStatusGroups.test.js",
    "test:backlog-priorities": "npm run compile-tests && node out/providers/backlogPriorities.test.js",
    "test:mcp": "npm run compile-tests && node out/mcp/core.test.js",
    "test:reviewers": "npm run compile-tests && node out/data/stores/ReviewerStore.test.js",
    "watch-tests": "tsc -p . -w --outDir out --noEmit false",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "clean": "rimraf dist",
    "test": "node ./out/test/runTest.js",
    "mcp": "rimraf out && tsc -p . --outDir out --noEmit false && node out/mcp/stdioServer.js",
    "standup": "rimraf out && tsc -p . --outDir out --noEmit false && node out/cli/standup.js"
  },
  "contributes": {
    "keybindings": [
      {
        "command": "sprintdesk.addTask",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "workspaceHasSprintDesk"
      },
      {
        "command": "sprintdesk.addQuickly",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "workspaceHasSprintDesk"
      }
    ],
    "commands": [
      {
        "command": "sprintdesk.addTask",
        "title": "SprintDesk: Add Task",
        "icon": "$(add)"
      },
      {
        "command": "sprintdesk.viewTasks",
        "title": "SprintDesk: View Tasks"
      },
      {
        "command": "sprintdesk.viewTaskPreview",
        "title": "SprintDesk: Preview Task",
        "icon": "$(eye)"
      },
      {
        "command": "sprintdesk.editTaskRaw",
        "title": "SprintDesk: Edit Task (Raw)",
        "icon": "$(edit)"
      },
      {
        "command": "sprintdesk.addMultipleTasks",
        "title": "SprintDesk: Add Multiple Tasks"
      },
      {
        "command": "sprintdesk.addQuickly",
        "title": "SprintDesk: Add Quickly"
      },
      {
        "command": "vscode-react-webview-starter.openWebview",
        "title": "React Webview: Open webview"
      },
      {
        "command": "sprintdesk.viewBacklogs",
        "title": "SprintDesk: View Backlogs"
      },
      {
        "command": "sprintdesk.viewEpics",
        "title": "SprintDesk: View Epics"
      },
      {
        "command": "sprintdesk.startFeatureFromTask",
        "title": "SprintDesk: Start Feature from Task",
        "icon": "$(git-branch)"
      },
      {
        "command": "sprintdesk.openSprintFile",
        "title": "SprintDesk: Open Sprint File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sprintdesk.showSprintCalendar",
        "title": "SprintDesk: Show Sprint Calendar",
        "icon": "$(calendar)"
      },
      {
        "command": "sprintdesk.addSprint",
        "title": "SprintDesk: Add Sprint",
        "icon": "$(add)"
      },
      {
        "command": "sprintdesk.addEpic",
        "title": "SprintDesk: Add Epic",
        "icon": "$(add)"
      },
      {
        "command": "sprintdesk.addBacklog",
        "title": "SprintDesk: Add Backlog",
        "icon": "$(add)"
      },
      {
        "command": "sprintdesk.addTaskToBacklog",
        "title": "SprintDesk: Add Task to Backlog",
        "icon": "$(add)"
      },
      {
        "command": "sprintdesk.refresh",
        "title": "SprintDesk: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sprintdesk.startMcp",
        "title": "SprintDesk: Start MCP Server",
        "icon": "$(server)"
      },
      {
        "command": "sprintdesk.addExistingTasksToSprint",
        "title": "SprintDesk: Add Tasks to Sprint",
        "icon": "$(add)"
      },
      {
        "command": "sprintdesk.addExistingTasksToBacklog",
        "title": "SprintDesk: Add Tasks to Backlog",
        "icon": "$(add)"
      },
      {
        "command": "sprintdesk.viewProjects",
        "title": "SprintDesk: Projects",
        "icon": "$(folder)"
      },
      {
        "command": "sprintdesk.createTaskFromRepo",
        "title": "SprintDesk: Create Task from Repository"
      },
      {
        "command": "sprintdesk.createEpicFromRepo",
        "title": "SprintDesk: Create Epic from Repository"
      },
      {
        "command": "sprintdesk.createSprintFromRepo",
        "title": "SprintDesk: Create Sprint from Repository"
      },
      {
        "command": "sprintdesk.createBacklogFromRepo",
        "title": "SprintDesk: Create Backlog from Repository"
      },
      {
        "command": "sprintdesk.viewTeam",
        "title": "SprintDesk: View Team",
        "icon": "$(account)"
      },
{
        "command": "sprintdesk.runAgent",
        "title": "SprintDesk: Run Agent",
        "icon": "$(play)"
      },
      {
        "command": "sprintdesk.syncTeamFromGit",
        "title": "SprintDesk: Sync Team from Git",
        "icon": "$(git-fetch)"
      },
      {
        "command": "sprintdesk.viewHistory",
        "title": "SprintDesk: View History",
        "icon": "$(history)"
      },
      {
        "command": "sprintdesk.getItemHistory",
        "title": "SprintDesk: Get Item History",
        "icon": "$(clock)"
      },
      {
        "command": "sprintdesk.viewWorkforce",
        "title": "SprintDesk: View Workforce",
        "icon": "$(organization)"
      },
      {
        "command": "sprintdesk.addEmployee",
        "title": "SprintDesk: Add Employee",
        "icon": "$(person-add)"
      },
      {
        "command": "sprintdesk.createTeam",
        "title": "SprintDesk: Create Team",
        "icon": "$(new-folder)"
      },
      {
        "command": "sprintdesk.assignToTeam",
        "title": "SprintDesk: Assign to Team",
        "icon": "$(add)"
      },
      {
        "command": "sprintdesk.setTeamLead",
        "title": "SprintDesk: Set Team Lead",
        "icon": "$(star)"
      },
      {
        "command": "sprintdesk.setEmployeeStatus",
        "title": "SprintDesk: Set Availability",
        "icon": "$(circle-filled)"
      },
      {
        "command": "sprintdesk.removeEmployee",
        "title": "SprintDesk: Remove Employee",
        "icon": "$(trash)"
      },
      {
        "command": "sprintdesk.syncWorkforceFromTeam",
        "title": "SprintDesk: Sync Workforce from Team",
        "icon": "$(sync)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sprintdesk",
          "title": "SprintDesk",
          "icon": "./assets/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "sprintdesk": [
        {
          "id": "sprintdesk-repositories",
          "name": "Repositories"
        },
        {
          "id": "sprintdesk-sprints",
          "name": "Sprints"
        },
        {
          "id": "sprintdesk-backlogs",
          "name": "Backlogs"
        },
        {
          "id": "sprintdesk-epics",
          "name": "Epics"
        },
        {
          "id": "sprintdesk-tasks",
          "name": "Tasks"
        },
        {
          "id": "sprintdesk-team",
          "name": "Team"
        },
        {
          "id": "sprintdesk-workforce",
          "name": "Workforce"
        },
        {
          "id": "sprintdesk-history",
          "name": "History"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "sprintdesk.addTask",
          "title": "SprintDesk: Create New Task",
          "when": "workspaceHasSprintDesk"
        }
      ],
      "view/title": [
        {
          "command": "sprintdesk.addSprint",
          "when": "view == sprintdesk-sprints",
          "group": "navigation"
        },
        {
          "command": "sprintdesk.addEpic",
          "when": "view == sprintdesk-epics",
          "group": "navigation"
        },
        {
          "command": "sprintdesk.addBacklog",
          "when": "view == sprintdesk-backlogs",
          "group": "navigation"
        },
        {
          "command": "sprintdesk.addTask",
          "when": "view == sprintdesk-tasks",
          "group": "navigation@1"
        },
        {
          "command": "sprintdesk.addTask",
          "when": "view == sprintdesk-repositories",
          "group": "navigation@1"
        },
        {
          "command": "sprintdesk.refresh",
          "when": "view =~ /^sprintdesk-/",
          "group": "navigation@9"
        },
        {
          "command": "sprintdesk.syncTeamFromGit",
          "when": "view == sprintdesk-team",
          "group": "navigation"
        },
        {
          "command": "sprintdesk.addAgent",
          "when": "view == sprintdesk-team",
          "group": "navigation"
        },
        {
          "command": "sprintdesk.addEmployee",
          "when": "view == sprintdesk-workforce",
          "group": "navigation@1"
        },
        {
          "command": "sprintdesk.createTeam",
          "when": "view == sprintdesk-workforce",
          "group": "navigation@2"
        },
        {
          "command": "sprintdesk.syncWorkforceFromTeam",
          "when": "view == sprintdesk-workforce",
          "group": "navigation@3"
        },
        {
          "command": "sprintdesk.getItemHistory",
          "when": "view == sprintdesk-history",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "sprintdesk.addQuickly",
          "group": "sprintdesk@1",
          "when": "workspaceHasSprintDesk"
        },
        {
          "command": "sprintdesk.addTask",
          "group": "sprintdesk@2",
          "when": "workspaceHasSprintDesk"
        }
      ],
      "view/item/context": [
        {
          "command": "sprintdesk.startFeatureFromTask",
          "when": "view == sprintdesk-sprints && viewItem == sprintTask",
          "group": "inline"
        },
        {
          "command": "sprintdesk.openSprintFile",
          "when": "view == sprintdesk-sprints && viewItem == sprint",
          "group": "inline@1"
        },
        {
          "command": "sprintdesk.showSprintCalendar",
          "when": "view == sprintdesk-sprints && viewItem == sprint",
          "group": "inline@2"
        },
        {
          "command": "sprintdesk.addExistingTasksToSprint",
          "when": "view == sprintdesk-sprints && viewItem == sprint",
          "group": "inline@3"
        },
        {
          "command": "sprintdesk.addExistingTasksToBacklog",
          "when": "view == sprintdesk-backlogs && viewItem == backlog",
          "group": "inline"
        },
        {
          "command": "sprintdesk.viewTaskPreview",
          "when": "view == sprintdesk-tasks && viewItem == task",
          "group": "inline"
        },
        {
          "command": "sprintdesk.editTaskRaw",
          "when": "view == sprintdesk-tasks && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "sprintdesk.createTaskFromRepo",
          "when": "view == sprintdesk-repositories && viewItem == repository",
          "group": "create@1"
        },
        {
          "command": "sprintdesk.createEpicFromRepo",
          "when": "view == sprintdesk-repositories && viewItem == repository",
          "group": "create@2"
        },
        {
          "command": "sprintdesk.createSprintFromRepo",
          "when": "view == sprintdesk-repositories && viewItem == repository",
          "group": "create@3"
        },
        {
          "command": "sprintdesk.createBacklogFromRepo",
          "when": "view == sprintdesk-repositories && viewItem == repository",
          "group": "create@4"
        },
        {
          "command": "sprintdesk.runAgent",
          "when": "view == sprintdesk-team",
          "group": "inline@0"
        },
        {
          "command": "sprintdesk.assignToTeam",
          "when": "view == sprintdesk-workforce && viewItem =~ /^employee/",
          "group": "inline@1"
        },
        {
          "command": "sprintdesk.setEmployeeStatus",
          "when": "view == sprintdesk-workforce && viewItem =~ /^employee/",
          "group": "inline@2"
        },
        {
          "command": "sprintdesk.removeEmployee",
          "when": "view == sprintdesk-workforce && viewItem =~ /^employee/",
          "group": "inline@3"
        },
        {
          "command": "sprintdesk.setTeamLead",
          "when": "view == sprintdesk-workforce && viewItem == workforceTeam",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "SprintDesk",
      "properties": {
        "sprintdesk.reviewerRegistrationEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Allow the MCP server to register human reviewers for task verification."
        },
        "sprintdesk.projectPrefix": {
          "type": "string",
          "default": "SPD",
          "description": "Project prefix used for code display (e.g., SPD-101)",
          "scope": "resource"
        },
        "sprintdesk.epicPrefix": {
          "type": "string",
          "default": "epic_",
          "description": "Epic ID prefix (for internal use)",
          "scope": "resource"
        },
        "sprintdesk.epicStartNumber": {
          "type": "number",
          "default": 1,
          "description": "Starting number for epic IDs",
          "scope": "resource"
        },
        "sprintdesk.epicPadding": {
          "type": "number",
          "default": 2,
          "description": "Number of digits for epic ID padding",
          "scope": "resource"
        },
        "sprintdesk.epicMdFilenamePattern": {
          "type": "string",
          "default": "[Epic]_${title}.md",
          "description": "Template for epic .md filename",
          "scope": "resource",
          "markdownDescription": "Template for epic .md filename. Use ${title} for epic title."
        },
        "sprintdesk.taskPrefix": {
          "type": "string",
          "default": "task_",
          "description": "Task ID prefix (e.g., task_ → task_100)",
          "scope": "resource",
          "markdownDescription": "Prefix used when generating new task IDs. Include trailing underscore if desired."
        },
        "sprintdesk.taskStartNumber": {
          "type": "number",
          "default": 100,
          "description": "Starting number for task IDs",
          "scope": "resource"
        },
        "sprintdesk.taskPadding": {
          "type": "number",
          "default": 3,
          "description": "Number of digits for task ID padding",
          "scope": "resource"
        },
        "sprintdesk.taskMdFilenamePattern": {
          "type": "string",
          "default": "[task-${taskNumber}]_${tasktitle}.md",
          "description": "Template for task .md filename",
          "scope": "resource",
          "markdownDescription": "Template for task .md filename. Use ${taskNumber} for task code and ${tasktitle} for title."
        },
        "sprintdesk.backlogMdFilenamePattern": {
          "type": "string",
          "default": "[Backlog]_${name}.md",
          "description": "Template for backlog .md filename",
          "scope": "resource",
          "markdownDescription": "Template for backlog .md filename. Use ${name} for backlog name."
        },
        "sprintdesk.sprintPrefix": {
          "type": "string",
          "default": "sprint_",
          "description": "Sprint ID prefix",
          "scope": "resource"
        },
        "sprintdesk.sprintStartNumber": {
          "type": "number",
          "default": 1,
          "description": "Starting number for sprint IDs",
          "scope": "resource"
        },
        "sprintdesk.sprintPadding": {
          "type": "number",
          "default": 1,
          "description": "Number of digits for sprint ID padding",
          "scope": "resource"
        },
        "sprintdesk.sprintMdFilenamePattern": {
          "type": "string",
          "default": "[Sprint]_${id}.md",
          "description": "Template for sprint .md filename",
          "scope": "resource",
          "markdownDescription": "Template for sprint .md filename. Use ${id} for sprint id."
        },
        "sprintdesk.defaultBacklog": {
          "type": "string",
          "default": "features",
          "description": "Default backlog for new tasks",
          "scope": "resource",
          "markdownDescription": "Name of the backlog where new tasks are created by default."
        },
        "sprintdesk.defaultStatus": {
          "type": "string",
          "default": "waiting",
          "description": "Default status for new tasks",
          "enum": [
            "waiting",
            "in-progress",
            "done",
            "blocked",
            "cancelled"
          ],
          "enumDescriptions": [
            "Not started yet",
            "Work in progress",
            "Completed",
            "Blocked — requires attention",
            "Cancelled / won't do"
          ],
          "scope": "resource"
        },
        "sprintdesk.defaultPriority": {
          "type": "string",
          "default": "medium",
          "description": "Default priority for new tasks",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "enumDescriptions": [
            "Low priority",
            "Normal priority",
            "High priority"
          ],
          "scope": "resource"
        },
        "sprintdesk.showIds": {
          "type": "boolean",
          "default": true,
          "description": "Show IDs in task labels",
          "scope": "resource"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "sprintdesk-mcp",
        "label": "SprintDesk MCP Server"
      }
    ]
  },
  "devDependencies": {
    "@estruyf/vscode": "^1.1.0",
    "@types/d3-dispatch": "^2.0.0",
    "@types/glob": "^7.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/minimatch": "^5.1.2",
    "@types/mocha": "^9.1.1",
    "@types/node": "16.x",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^8.3.4",
    "@types/vscode": "^1.99.0",
    "@types/webpack": "^5.28.1",
    "@types/webpack-dev-server": "^4.7.2",
    "@typescript-eslint/eslint-plugin": "^5.31.0",
    "@typescript-eslint/parser": "^5.31.0",
    "@vscode/test-electron": "^2.1.5",
    "css-loader": "^6.7.1",
    "eslint": "^8.20.0",
    "glob": "^8.0.3",
    "mocha": "^10.0.0",
    "npm-run-all": "^4.1.5",
    "postcss-loader": "^7.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^3.0.2",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.4.1",
    "typescript": "^4.7.4",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0",
    "webpack-manifest-plugin": "^5.0.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "react-flow-renderer": "^10.3.17"
  }
}