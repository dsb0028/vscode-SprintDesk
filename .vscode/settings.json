// Place your settings in this file to overwrite default and user settings.
{
    "files.exclude": {
        "out": false,
        "dist": false
    },
    "search.exclude": {
        "out": true,
        "dist": true
    },
    "typescript.tsc.autoDetect": "off",
    "codium.codeCompletion.enable": false,

    // SprintDesk Settings
    "sprintdesk.taskPrefix": "task_",
    "sprintdesk.taskStartNumber": 100,
    "sprintdesk.taskPadding": 3,
    "sprintdesk.epicPrefix": "epic_",
    "sprintdesk.sprintPrefix": "sprint_",
    "sprintdesk.defaultBacklog": "features",
    "sprintdesk.defaultStatus": "waiting",
    "sprintdesk.defaultPriority": "medium",
    "sprintdesk.showIds": true
}